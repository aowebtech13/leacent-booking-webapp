- var page_Title = 'Unlock User';
doctype html
html(lang='en')
  include ../../components/header-files
  body
    include ../../components/loader
    include ../../components/taptop
    // page-wrapper Start
    .page-wrapper
      .container-fluid.p-0
        // Unlock page start
        .authentication-main.mt-0
          .row
            .col-12
              .login-card.login-dark
                div
                  div
                    a.logo(href="index.html")
                      img.img-fluid.for-light(src="https://res.cloudinary.com/dqi7g7lky/image/upload/v1793002438/WhatsApp_Image_0008-10-26_at_01.07.28-removebg-preview-removebg-preview_giyzud.png" alt="looginpage" )
                      img.img-fluid.for-dark(src="https://res.cloudinary.com/dqi7g7lky/image/upload/v1793002438/WhatsApp_Image_0008-10-26_at_01.07.28-removebg-preview-removebg-preview_giyzud.png" alt="looginpage" )
                  .login-main
                    form.theme-form
                      h4 Unlock                          
                      .form-group
                        label.col-form-label Enter your Password
                        .form-input.position-relative
                          input.form-control(type='password', name='login[password]', required='' placeholder="*********")
                          .show-hide
                            span.show                       
                      .form-group.mb-0
                        .form-check
                          input#checkbox1.form-check-input.checkbox-primary(type='checkbox')
                          label.text-muted.form-check-label(for='checkbox1') Remember password
                        button.btn.btn-primary.btn-block.w-100.mt-3(type='submit') Unlock
                      p.mt-4.mb-0 Already Have an account?
                        a.ms-2(href="login.html") Sign in
        // Unlock page end
        // page-wrapper Ends
        include ../../components/footer-files
